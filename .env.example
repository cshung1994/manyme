# Base
BASE_RPC_URL=https://sepolia.base.org
BASE_WS_URL=
BASE_CHAIN_ID=8453
BASE_SEPOLIA_CHAIN_ID=84532

# Contracts
ESCROW_CONTRACT_ADDRESS=
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Platform
PLATFORM_WALLET=
PLATFORM_OPERATOR_KEY=
DEPLOYER_PRIVATE_KEY=

# OnchainOS
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# AI (Google AI Studio)
GEMINI_API_KEY=
AI_MODEL_LIVE=gemini-2.0-flash
AI_MODEL_SYNTHESIS=gemini-2.5-pro-exp-03-25

# x402
X402_PAYMENT_ADDRESS=
X402_NETWORK=base-sepolia
# Set to false (and set PLATFORM_WALLET) to verify/settle real payments via the facilitator
X402_MOCK=true
X402_FACILITATOR_URL=https://x402.org/facilitator
# Frontend counterpart (frontend/.env.local): NEXT_PUBLIC_X402_MOCK=true

# Billing
# Dev-only: credit deposits without on-chain verification
ALLOW_UNVERIFIED_DEPOSITS=false

# Database
DATABASE_URL=file:./dev.db
